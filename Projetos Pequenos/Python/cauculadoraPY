(2)
import math

a = float(input("Digite o valor de a: "))
b = float(input("Digite o valor de b: "))
c = float(input("Digite o valor de c: "))

delta = b**2 - 4*a*c

if a == 0:
    print("\nIsso não é uma equação de segundo grau (a = 0).")
elif delta < 0:
    print("\nA equação não possui raízes reais (delta < 0).")
elif delta == 0:
    x = -b / (2*a)
    print(f"\nA equação possui uma raiz real: x = {x}")
else:
    x1 = (-b + math.sqrt(delta)) / (2*a)
    x2 = (-b - math.sqrt(delta)) / (2*a)
    print(f"\nAs raízes da equação são: x1 = {x1}, x2 = {x2}")

